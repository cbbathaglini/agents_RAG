# Copie este arquivo para ".env" e preencha com SUAS chaves.
# NUNCA versione o ".env" de verdade.

DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

ATLASCLOUD_API_KEY=apikey-...
ATLASCLOUD_BASE_URL=https://api.atlascloud.ai/api/v1/model
VIDEO_MODEL=alibaba/wan-2.7/image-to-video

# Pasta de cache do modelo de embeddings (opcional; padrão: ./.cache)
# MODEL_CACHE_DIR=./.cache
